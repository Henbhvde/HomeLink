generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Tenant {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  status           TenantAccessStatus @default(active)
    users            User[]
    workspaceMemberships WorkspaceMembership[]
  subscription     Subscription?
  buildings        Building[]
  units            Unit[]
  residentProfiles ResidentProfile[]
  tariffs          Tariff[]
  invoices         Invoice[]
  payments         Payment[]
  ledgerEntries    LedgerEntry[]
  meters           Meter[]
  maintenanceRequests MaintenanceRequest[]
  announcements    Announcement[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  fileAttachments  FileAttachment[]
  invites          Invite[]
  passwordResetAttempts PasswordResetAttempt[]
  entrances        Entrance[]
  floors           Floor[]
  invoiceLines     InvoiceLine[]
  paymentAllocations PaymentAllocation[]
  accountingPeriods AccountingPeriod[]
  creditBalances    CreditBalance[]
  meterReadings    MeterReading[]
  workOrders       WorkOrder[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum TenantAccessStatus {
  pending
  active
  trial
  overdue
  read_only
  rejected
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum UnitStatus {
  vacant
  occupied
  inactive
}

enum ResidentStatus {
  invited
  pending
  active
  inactive
  rejected
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 String
  status               SubscriptionStatus @default(trialing)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Building {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  code       String
  address    String?
  entrances  Entrance[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Entrance {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  floors     Floor[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@unique([buildingId, name])
  @@index([buildingId])
  @@index([tenantId])
}

model Floor {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entranceId String
  entrance   Entrance  @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  number     Int
  units      Unit[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@unique([entranceId, number])
  @@index([entranceId])
  @@index([tenantId])
}

model Unit {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floorId          String
  floor            Floor             @relation(fields: [floorId], references: [id], onDelete: Cascade)
  number           String
  areaSqm          Float?
  status           UnitStatus        @default(vacant)
  residentProfiles ResidentProfile[]
  invoices         Invoice[]
  meters           Meter[]
  creditBalances   CreditBalance[]
  maintenanceRequests MaintenanceRequest[]
  invites          Invite[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  @@unique([floorId, number])
  @@index([tenantId])
  @@index([floorId])
}

model ResidentProfile {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  requestedBuilding String?
  requestedEntrance String?
  requestedFloor    Int?
  requestedUnit     String?
  status    ResidentStatus @default(invited)
  isOwner   Boolean        @default(false)
  isPrimary Boolean        @default(false)
  moveInAt  DateTime?
  moveOutAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  invoices  Invoice[]
  payments  Payment[]
  maintenanceRequests MaintenanceRequest[]
  @@index([tenantId])
  @@unique([tenantId, userId])
  @@index([tenantId, unitId])
  @@index([unitId])
}

enum InvoiceStatus {
  draft
  approved
  sent
  paid
  overdue
  void
}

enum PaymentStatus {
  pending
  confirmed
  failed
  refunded
}

enum LedgerEntryType {
  debit
  credit
  adjustment
}

model Tariff {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  serviceCode String
  billingUnit String
  unitPrice   Decimal       @db.Decimal(14, 2)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  isActive    Boolean       @default(true)
  invoiceLines InvoiceLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([tenantId, serviceCode, effectiveFrom])
  @@index([tenantId, isActive, effectiveFrom])
}

model Invoice {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId            String
  unit              Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  residentProfileId String?
  residentProfile   ResidentProfile? @relation(fields: [residentProfileId], references: [id], onDelete: SetNull)
  number            String
  status            InvoiceStatus   @default(draft)
  periodStart       DateTime
  periodEnd         DateTime
  dueAt             DateTime
  subtotal          Decimal         @db.Decimal(14, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount       Decimal         @db.Decimal(14, 2)
  approvedAt        DateTime?
  sentAt            DateTime?
  paidAt            DateTime?
  lines             InvoiceLine[]
  allocations       PaymentAllocation[]
  ledgerEntries     LedgerEntry[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@unique([tenantId, number])
  @@index([tenantId, status, dueAt])
  @@index([unitId, periodStart])
  @@index([residentProfileId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tariffId    String?
  tariff      Tariff?  @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  @@index([invoiceId])
  @@index([tenantId])
  @@index([tariffId])
}

model Payment {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residentProfileId String?
  residentProfile   ResidentProfile? @relation(fields: [residentProfileId], references: [id], onDelete: SetNull)
  reference         String
  requestHash       String?
  method            String
  status            PaymentStatus    @default(pending)
  amount            Decimal          @db.Decimal(14, 2)
  paidAt            DateTime?
  allocations       PaymentAllocation[]
  ledgerEntries     LedgerEntry[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  @@unique([tenantId, reference])
  @@index([tenantId, status, paidAt])
  @@index([residentProfileId])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@index([tenantId])
}

model AccountingPeriod {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  periodStart DateTime
  periodEnd   DateTime
  isLocked    Boolean   @default(false)
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId, isLocked, periodStart, periodEnd])
}

model CreditBalance {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amount    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, unitId])
  @@index([tenantId, amount])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId   String?
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type        LedgerEntryType
  account     String
  amount      Decimal         @db.Decimal(14, 2)
  description String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  @@index([tenantId, occurredAt])
  @@index([invoiceId])
  @@index([paymentId])
}

enum MeterType {
  water
  electricity
  heating
  gas
}

enum MeterReadingStatus {
  pending
  approved
  flagged
  rejected
}

enum MaintenancePriority {
  low
  normal
  high
  urgent
}

enum MaintenanceStatus {
  open
  assigned
  in_progress
  resolved
  closed
  canceled
}

enum WorkOrderStatus {
  assigned
  in_progress
  completed
  canceled
}

enum AnnouncementAudience {
  all
  residents
  staff
}

enum NotificationType {
  info
  billing
  payment
  maintenance
  announcement
}

model Meter {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  serialNumber String
  type         MeterType
  isActive     Boolean        @default(true)
  installedAt DateTime?
  readings     MeterReading[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@unique([tenantId, serialNumber])
  @@index([unitId, type])
  @@index([tenantId, isActive])
}

model MeterReading {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meterId       String
  meter         Meter              @relation(fields: [meterId], references: [id], onDelete: Cascade)
  recordedById  String?
  recordedBy    User?              @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  previousValue Decimal            @db.Decimal(14, 3)
  currentValue  Decimal            @db.Decimal(14, 3)
  usage         Decimal            @db.Decimal(14, 3)
  status        MeterReadingStatus @default(pending)
  readAt        DateTime
  photoUrl      String?
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  @@unique([meterId, readAt])
  @@index([meterId, status])
  @@index([recordedById])
  @@index([tenantId, readAt])
}

model MaintenanceRequest {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId             String?
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  requesterProfileId String?
  requesterProfile   ResidentProfile?    @relation(fields: [requesterProfileId], references: [id], onDelete: SetNull)
  title              String
  description        String
  priority           MaintenancePriority @default(normal)
  status             MaintenanceStatus   @default(open)
  slaDueAt           DateTime?
  resolvedAt         DateTime?
  workOrders         WorkOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@index([tenantId, status, priority])
  @@index([unitId])
  @@index([requesterProfileId])
}

model WorkOrder {
  id                   String          @id @default(cuid())
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  assigneeId           String?
  assignee             User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  status               WorkOrderStatus @default(assigned)
  scheduledAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  @@index([maintenanceRequestId])
  @@index([assigneeId, status])
  @@index([tenantId, status])
}

model Announcement {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title       String
  body        String
  audience    AnnouncementAudience @default(all)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@index([tenantId, publishedAt])
  @@index([authorId])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(info)
  title     String
  body      String
  route     String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  @@index([userId, readAt, createdAt])
  @@index([tenantId, createdAt])
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model FileAttachment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  entityType   String
  entityId     String
  fileName     String
  mimeType     String
  sizeBytes    BigInt
  storageKey   String   @unique
  url          String
  createdAt    DateTime @default(now())
  @@index([tenantId, entityType, entityId])
  @@index([uploadedById])
}

model Invite {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  invitedById String?
  invitedBy   User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  email       String?
  phone       String?
  role        UserRole     @default(resident)
  tokenHash   String       @unique
  status      InviteStatus @default(pending)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([tenantId, status, expiresAt])
  @@index([unitId])
  @@index([email])
  @@index([phone])
}

model PasswordResetAttempt {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  codeHash   String?
  ipAddress  String?
  userAgent  String?
  successful Boolean  @default(false)
  expiresAt  DateTime?
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

model AppState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum UserRole {
  unassigned
  super_admin
  manager
  accountant
  staff
  resident
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  oauthProvider String?
  oauthSubject  String?
  avatarUrl      String?
  emailVerifiedAt DateTime?
  role         UserRole @default(unassigned)
  tenantId     String?
    tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
    workspaceMemberships WorkspaceMembership[]
  residentProfiles ResidentProfile[]
  meterReadings   MeterReading[]
  assignedWorkOrders WorkOrder[]
  announcements  Announcement[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  fileAttachments FileAttachment[]
  sentInvites    Invite[]
  passwordResetAttempts PasswordResetAttempt[]
  refreshTokens   RefreshToken[]
  building     String?
  apartment    String?
  passwordResetCodeHash String?
  passwordResetExpiresAt DateTime?
  passwordResetVerifiedAt DateTime?
  passwordResetTokenHash String?
  passwordResetTokenExpiresAt DateTime?
  isActive     Boolean  @default(true)
  onboardingCompleted Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([role])
  @@unique([oauthProvider, oauthSubject])
}

model WorkspaceMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      UserRole @default(manager)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String
  tokenHash   String   @unique
  replacedBy  String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([userId, revokedAt])
  @@index([tenantId, familyId])
  @@index([familyId, revokedAt])
}
