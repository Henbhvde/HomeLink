{
  "name": "smart-property-management-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:ci": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate-json": "tsx prisma/migrate.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.8",
    "@prisma/client": "^5.10.0",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.17.2",
    "redis": "^4.6.0",
    "socket.io": "^4.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/pdfkit": "^0.17.3",
    "eslint": "^9.39.0",
    "prisma": "^5.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.0"
  }
}
